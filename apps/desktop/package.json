{
  "name": "@preset-doctor/desktop",
  "productName": "Preset Doctor",
  "version": "0.2.1",
  "private": true,
  "description": "Finds and repairs Bambu Studio and OrcaSlicer presets that disappeared after an update.",
  "author": "Preset Doctor contributors",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "icon": "node scripts/make-icon.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -b",
    "dist": "electron-vite build && electron-builder --win portable --publish never",
    "e2e": "electron-vite build && node e2e/smoke.mts"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "playwright-core": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  }
}
