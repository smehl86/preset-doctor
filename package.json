{
  "name": "preset-doctor-monorepo",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:live": "vitest run --mode live",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fixtures": "node scripts/make-fixtures.ts",
    "cli": "node packages/core/dist/cli.js",
    "desktop:dev": "npm run dev -w @preset-doctor/desktop",
    "desktop:e2e": "npm run e2e -w @preset-doctor/desktop",
    "desktop:dist": "npm run dist -w @preset-doctor/desktop",
    "web:dev": "npm run dev -w @preset-doctor/web",
    "web:build": "npm run build -w @preset-doctor/web",
    "web:preview": "npm run preview -w @preset-doctor/web",
    "web:e2e": "npm run e2e -w @preset-doctor/web",
    "screenshots": "npm run e2e -w @preset-doctor/desktop -- --screenshots && npm run e2e -w @preset-doctor/web -- --screenshots"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
